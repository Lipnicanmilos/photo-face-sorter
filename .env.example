# Skopíruj ako .env a uprav podľa potreby. Všetky hodnoty sú voliteľné.

# --- Zhlukovanie ---
DBSCAN_EPS=0.5
DBSCAN_MIN_SAMPLES=2

# --- Úložisko ---
CACHE_DIR=cache/faces
DB_PATH=cache/photo_face_sorter.sqlite3

# --- Triedenie do priečinkov ---
OUTPUT_DIR=output
# hardlink (nezaberá miesto navyše) | copy | symlink
LINK_MODE=hardlink
UNASSIGNED_DIR_NAME=_nezaradene
NO_FACES_DIR_NAME=_bez_tvari

# --- InsightFace ---
INSIGHTFACE_MODEL_NAME=buffalo_l
# Knižnica si v tomto koreni sama vytvorí podpriečinok models/{INSIGHTFACE_MODEL_NAME}
# INSIGHTFACE_ROOT=~/.insightface
INSIGHTFACE_CTX_ID=-1
INSIGHTFACE_DET_SIZE=640

# --- Filtrovanie detekcií ---
MIN_DET_SCORE=0.5
MIN_FACE_SIZE=32
PREVIEW_SIZE=160
